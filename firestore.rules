rules_version = '2';

// Data layout and the client code that writes it: src/services/firebaseApi.ts
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Staff roles: admins/{email} = { role: 'SUPER_ADMIN' | 'HC_TV' | 'TT_SK' | 'QLNS_CTSV' } ----------
    // Legacy values still accepted: EVENT_MANAGER (= HC_TV), EDITOR (= TT_SK). Mirrors src/utils/roles.ts.

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function adminPath() {
      return /databases/$(database)/documents/admins/$(request.auth.token.email);
    }

    function hasRole(roles) {
      return signedIn() && exists(adminPath()) && get(adminPath()).data.role in roles;
    }

    // Every staff role may run the QR check-in station
    function isStaff() { return hasRole(['SUPER_ADMIN', 'HC_TV', 'TT_SK', 'QLNS_CTSV', 'EVENT_MANAGER', 'EDITOR']); }
    function canManageEvents() { return hasRole(['SUPER_ADMIN', 'HC_TV', 'TT_SK', 'EVENT_MANAGER', 'EDITOR']); }
    function canEditNews() { return hasRole(['SUPER_ADMIN', 'TT_SK', 'EDITOR']); }
    function canManageMembers() { return hasRole(['SUPER_ADMIN', 'QLNS_CTSV']); }
    function isSuperAdmin() { return hasRole(['SUPER_ADMIN']); }

    function registrationPath(regId) {
      return /databases/$(database)/documents/registrations/$(regId);
    }

    // True when this request is the write that creates registrations/{regId}
    function createsRegistration(regId) {
      return !exists(registrationPath(regId)) && existsAfter(registrationPath(regId));
    }

    // Managed from Quản trị → Phân quyền. A Super Admin cannot change or remove their own
    // account, so the last Super Admin can never lock everyone out.
    match /admins/{email} {
      allow get: if signedIn() && request.auth.token.email == email;
      allow read: if isSuperAdmin();
      allow delete: if isSuperAdmin() && email != request.auth.token.email;
      allow create, update: if isSuperAdmin()
        && email != request.auth.token.email
        && email == email.lower()
        && request.resource.data.keys().hasOnly(['role', 'updatedAt'])
        && request.resource.data.role in ['SUPER_ADMIN', 'HC_TV', 'TT_SK', 'QLNS_CTSV'];
    }

    // ---------- Public content ----------

    match /news/{newsId} {
      allow read: if true;
      allow write: if canEditNews();
    }

    // BCH / Đội CTV cards on the "Cơ cấu Tổ chức" page; public, so no phone number field
    match /bch/{memberId} {
      allow read: if true;
      allow delete: if canManageMembers();
      allow create, update: if canManageMembers() && isValidBch();
    }

    function isValidBch() {
      let b = request.resource.data;
      return b.keys().hasOnly(['name', 'position', 'organization', 'email', 'classGroup', 'avatarUrl', 'bio',
                               'department', 'order'])
        && b.name is string && b.name.size() > 0 && b.name.size() <= 100
        && b.organization in ['DOAN_KHOA', 'HOI_SINH_VIEN', 'DOI_CTV']
        && b.order is int
        && b.avatarUrl is string && b.avatarUrl.size() <= 300000
        && (b.avatarUrl == '' || b.avatarUrl.matches('^(https://|data:image/).*'))
        && b.bio is string && b.bio.size() <= 1000;
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /emailLogs/{logId} {
      allow read, write: if canManageEvents();
      // Check-in confirmation queued by whoever scans the ticket
      allow create: if isStaff();
    }

    // ---------- Events & public self-registration ----------

    match /events/{eventId} {
      allow read: if true;
      allow create, delete: if canManageEvents();
      allow update: if canManageEvents() || isRegistrationCounterBump(eventId) || (isStaff() && isCheckInCounterBump());
    }

    // Staff without event rights may only count one more check-in
    function isCheckInCounterBump() {
      let before = resource.data;
      let after = request.resource.data;
      return after.diff(before).affectedKeys().hasOnly(['checkedInCount'])
        && after.checkedInCount == before.get('checkedInCount', 0) + 1;
    }

    // Anonymous visitors may only add one participant, in the same transaction that
    // creates the matching registration, and may only close a full event.
    function isRegistrationCounterBump(eventId) {
      let before = resource.data;
      let after = request.resource.data;
      let regId = after.lastRegistrationId;
      return after.diff(before).affectedKeys().hasOnly(['currentParticipants', 'status', 'lastRegistrationId'])
        && regId is string
        && after.currentParticipants == before.currentParticipants + 1
        && (after.status == before.status
            || (after.status == 'REGISTRATION_CLOSED' && after.currentParticipants >= before.maxParticipants))
        && createsRegistration(regId)
        && getAfter(registrationPath(regId)).data.eventId == eventId;
    }

    // registrations/{eventId}_{mssvKey}: the ticket, without contact details.
    // `get` is public (duplicate check, MSSV lookup); listing everything is staff only.
    match /registrations/{regId} {
      allow get: if true;
      allow list: if isStaff();
      allow update, delete: if canManageEvents();
      allow update: if isStaff() && isCheckInUpdate();
      allow create: if isValidRegistration(regId);
    }

    // Marking a ticket as checked in: the only change the QR station makes
    function isCheckInUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      return after.diff(before).affectedKeys().hasOnly(['checkedIn', 'checkedInAt'])
        && before.checkedIn == false
        && after.checkedIn == true
        && after.checkedInAt is string && after.checkedInAt.size() <= 40;
    }

    function isValidRegistration(regId) {
      let r = request.resource.data;
      let eventPath = /databases/$(database)/documents/events/$(r.eventId);
      let event = get(eventPath).data;
      return r.keys().hasOnly(['eventId', 'eventTitle', 'fullName', 'mssv', 'mssvKey', 'classGroup',
                               'faculty', 'registeredAt', 'ticketCode', 'checkedIn'])
        && r.keys().hasAll(['eventId', 'eventTitle', 'fullName', 'mssv', 'mssvKey', 'classGroup',
                            'faculty', 'registeredAt', 'ticketCode', 'checkedIn'])
        && r.mssvKey is string && r.mssvKey.matches('^[a-z0-9]{1,20}$')
        && r.mssv is string && r.mssv.lower() == r.mssvKey
        && regId == r.eventId + '_' + r.mssvKey
        && r.fullName is string && r.fullName.size() > 0 && r.fullName.size() <= 100
        && r.classGroup is string && r.classGroup.size() <= 50
        && r.faculty is string && r.faculty.size() <= 100
        && r.registeredAt is string && r.registeredAt.size() <= 40
        && r.ticketCode is string && r.ticketCode.size() <= 32
        && r.checkedIn == false
        && r.eventTitle == event.title
        && event.status == 'REGISTRATION_OPEN'
        && event.currentParticipants < event.maxParticipants
        && getAfter(eventPath).data.currentParticipants == event.currentParticipants + 1
        && existsAfter(/databases/$(database)/documents/registrationContacts/$(regId))
        && getAfter(/databases/$(database)/documents/students/$(r.mssvKey)).data.lastEventId == r.eventId;
    }

    // Email / phone / note of a registration: written once with it, readable by staff only.
    match /registrationContacts/{regId} {
      allow read, update, delete: if canManageEvents();
      // The QR station shows the scanned student's contact card
      allow get: if isStaff();
      allow create: if request.resource.data.keys().hasOnly(['email', 'phone', 'note'])
        && request.resource.data.keys().hasAll(['email', 'phone', 'note'])
        && request.resource.data.email is string && request.resource.data.email.size() <= 100
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && createsRegistration(regId);
    }

    // students/{mssvKey}: which events an MSSV registered for, used by the public lookup.
    match /students/{mssvKey} {
      allow get: if true;
      allow list, delete: if canManageEvents();
      allow create: if isStudentIndexWrite(mssvKey, []);
      allow update: if canManageEvents() || isStudentIndexWrite(mssvKey, resource.data.eventIds);
    }

    // ---------- Student / Đoàn viên / Hội viên records (Ban QLNS-CTSV) ----------

    match /members/{memberId} {
      allow read, delete: if canManageMembers();
      allow create, update: if canManageMembers() && isValidMember(memberId);

      // First sign-in with an @hcmut.edu.vn account: the student may read a record that is not
      // linked yet (to check MSSV + name) or is linked to them, and fill in their own details.
      allow get: if isHcmutUser() && linkableBy(resource.data);
      allow list: if isHcmutUser() && resource.data.accountEmail == request.auth.token.email;
      allow update: if isHcmutUser() && linkableBy(resource.data) && isOwnProfileUpdate(memberId);
    }

    function isHcmutUser() {
      return signedIn() && request.auth.token.email.matches('.*@hcmut[.]edu[.]vn$');
    }

    function linkableBy(member) {
      return member.get('accountEmail', '') == '' || member.accountEmail == request.auth.token.email;
    }

    function isOwnProfileUpdate(memberId) {
      let after = request.resource.data;
      return after.diff(resource.data).affectedKeys().hasOnly(['gender', 'dateOfBirth', 'classGroup', 'email', 'phone',
                                                               'isUnionMember', 'unionJoinDate', 'isAssociationMember',
                                                               'status', 'accountEmail', 'profileCompletedAt', 'updatedAt'])
        && after.accountEmail == request.auth.token.email
        && after.phone is string && after.phone.size() <= 20
        && after.email is string && after.email.size() <= 100
        && after.classGroup is string && after.classGroup.matches('^[A-Z0-9]{8}$')
        && isValidMember(memberId);
    }

    function isValidMember(memberId) {
      let m = request.resource.data;
      return m.keys().hasOnly(['mssv', 'fullName', 'gender', 'dateOfBirth', 'cohort', 'classGroup', 'email', 'phone',
                               'isUnionMember', 'unionJoinDate', 'isAssociationMember',
                               'status', 'note', 'updatedAt', 'accountEmail', 'profileCompletedAt'])
        && memberId.matches('^[a-z0-9]{1,20}$')
        && m.mssv is string && m.mssv.lower() == memberId
        && m.fullName is string && m.fullName.size() > 0 && m.fullName.size() <= 100
        && m.isUnionMember is bool
        && m.isAssociationMember is bool
        && m.status in ['STUDYING', 'RESERVED', 'GRADUATED', 'DROPPED']
        && m.note is string && m.note.size() <= 500;
    }

    function isStudentIndexWrite(mssvKey, previousEventIds) {
      let s = request.resource.data;
      return s.keys().hasOnly(['mssv', 'fullName', 'classGroup', 'eventIds', 'lastEventId'])
        && s.mssv is string && s.mssv.lower() == mssvKey
        && s.fullName is string && s.fullName.size() <= 100
        && s.classGroup is string && s.classGroup.size() <= 50
        && s.eventIds is list
        && s.eventIds.size() == previousEventIds.size() + 1
        && s.eventIds.hasAll(previousEventIds)
        && s.lastEventId is string
        && s.lastEventId in s.eventIds
        && !(s.lastEventId in previousEventIds)
        && createsRegistration(s.lastEventId + '_' + mssvKey);
    }
  }
}
