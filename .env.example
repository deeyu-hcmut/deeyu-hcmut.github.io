# Copy to .env.local for local development. Everything here is optional:
# by default the app uses the `deeyu-hcmut` Firebase project (src/services/firebaseConfig.ts).

# "true" to talk to `firebase emulators:start` (Firestore :8080, Auth :9099) instead of the live project.
# Also set VITE_FIREBASE_PROJECT_ID="demo-fee-portal" so no real project is touched.
VITE_FIREBASE_EMULATOR=""
VITE_FIREBASE_PROJECT_ID=""

# "true" to run the old demo without Firebase: data lives in the browser's localStorage,
# or in the Express API (server.ts) under `npm run dev`.
VITE_DEMO_MODE=""

# Only with VITE_DEMO_MODE: set to "true" when building for a deployment that runs server.ts
# (npm run build && npm start).
VITE_API_SERVER=""
