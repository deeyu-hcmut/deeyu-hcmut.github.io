# Copy to .env.local for local development.

# --- Firebase (Firestore database + Google sign-in for staff) ---
# Firebase console → Project settings → Your apps → Web app → SDK config.
# These values are public by design; access is enforced by firestore.rules.
# Leave them empty to run the localStorage demo instead.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""

# "true" to talk to `firebase emulators:start` (Firestore :8080, Auth :9099) instead of the live project.
VITE_FIREBASE_EMULATOR=""

# --- Express API (server.ts), only used when Firebase is not configured ---
# Set to "true" when building for a deployment that runs server.ts
# (npm run build && npm start). `npm run dev` always uses the Express API.
VITE_API_SERVER=""
